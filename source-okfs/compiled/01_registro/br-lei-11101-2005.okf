    },
    {
      "id": "BR.LEI.11101.2005#10",
      "type": "artigo_candidato",
      "name": "Art. 69",
      "content": "art. 69 da Lei nš \r\n 13.105, de 16 de marįo de 2015 (Código de Processo Civil)\n, observado \r\n o disposto no",
      "attributes": {
