    {
      "id": "BR.LC.123.2006#126",
      "type": "artigo_candidato",
      "name": "Art. 42",
      "content": "Art. 42.  Nas licitaçőes \r\npúblicas, a comprovaçăo de regularidade fiscal das microempresas e empresas de \r\npequeno porte somente será exigida para efeito de assinatura do contrato.",
      "attributes": {
