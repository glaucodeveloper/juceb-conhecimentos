      "id": "BR.LC.123.2006#187",
      "type": "artigo_candidato",
      "name": "Art. 69",
      "content": "Art. 69.  (VETADO).\nSeçăo II\nDas Deliberaçőes \r\nSociais e da Estrutura Organizacional",
