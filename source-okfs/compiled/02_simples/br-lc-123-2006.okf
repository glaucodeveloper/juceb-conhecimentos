    {
      "id": "BR.LC.123.2006#167",
      "type": "artigo_candidato",
      "name": "Art. 6",
      "content": "Art.\n6\n1\n-C.\nCaso\nos sócios\ndecid\na\nm\npela\nvenda\nda\ne\nm\np\nresa,\no investido\nr\n-\na\nnjo terá\nd\ni\nreito\nde\npre\nf\neręncia\nn\na\naquisiçăo,\nb\ne\nm\nc\no\nmo direito\nde\nv\nenda\nco\nnj\nu\nn\nta\nda\ntit\nu\nlaridade\nd\no\naporte\nde\ncapital,\nn\nos\nm\nes\nm\nos\nte\nr\nm\nos\ne\nc\nondiçőes\nque\nf\nor\ne\nm \r\no\nf\nertados aos sóc\ni\nos \r\nregulares.\n(Incluído pela Lei Complementar nş 155, de 2016)\nProduçăo de efeito",
      "attributes": {
        "automated_extraction": true,
        "char_start": 235258,
        "char_end": 235635
      }
    },
    {
      "id": "BR.LC.123.2006#168",
      "type": "artigo_candidato",
      "name": "Art. 61-D",
      "content": "Art.\n61-D.\nOs\nf\nund\no\ns \r\nde invest\ni\nm\nen\nt\no\np\no\nderăo aportar capit\na\nl c\no\nm\no\ninvesti\nd\nore\ns\n-an\nj\nos\nem\nm\nic\nr\no\ne\nm\npr\ne\nsas\ne\ne\nm\npresas\nde\npe\nq\nu\ne\nno \r\nporte.\n(Incluído pela Lei Complementar nş 155, de 2016)\nProduçăo de efeito",
