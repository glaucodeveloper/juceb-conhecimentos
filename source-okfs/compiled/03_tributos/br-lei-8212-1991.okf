    {
      "id": "BR.LEI.8212.1991#191",
      "type": "artigo_candidato",
      "name": "Art. 82",
      "content": "Art. \r\n82. A Auditoria e a Procuradoria do Instituto Nacional do Seguro Social-INSS \r\ndeverăo, a cada trimestre, elaborar relaçăo das auditorias realizadas e dos \r\ntrabalhos executados, bem como dos resultados obtidos, enviando-a a apreciaçăo \r\ndo Conselho Nacional da Seguridade Social.",
      "attributes": {
