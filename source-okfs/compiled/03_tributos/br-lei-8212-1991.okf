    {
      "id": "BR.LEI.8212.1991#97",
      "type": "artigo_candidato",
      "name": "Art. 33",
      "content": "Art. 33.  Ŕ Secretaria da Receita Federal do \r\n Brasil compete planejar, executar, acompanhar e avaliar as atividades \r\n relativas ŕ tributaçăo, ŕ fiscalizaçăo, ŕ arrecadaçăo, ŕ cobrança e ao \r\n recolhimento das contribuiçőes sociais previstas no parágrafo único do",
      "attributes": {
