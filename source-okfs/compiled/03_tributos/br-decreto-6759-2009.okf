    {
      "id": "BR.DECRETO.6759.2009#372",
      "type": "artigo_candidato",
      "name": "Art. 6",
      "content": "art. 6ş \r\nda Lei nş 11.484, de 2007\n, e que exerça isoladamente ou em \r\nconjunto, em relaçăo a dispositivos (\nLei nş 11.484, de 2007,",
      "attributes": {
