      }
    },
    {
      "id": "BR.DECRETO.6759.2009#494",
      "type": "artigo_candidato",
      "name": "Art. 382",
      "content": "Art. 382.  Aplicam-se ao regime, no que couber, as \r\nnormas previstas para o regime de admissăo temporária.\nCAPÍTULO V\nDO \r\nDRAWBACK\nSeçăo I\nDas Disposiçőes Preliminares",
      "attributes": {
