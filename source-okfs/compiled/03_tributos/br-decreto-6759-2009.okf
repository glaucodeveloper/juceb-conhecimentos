    {
      "id": "BR.DECRETO.6759.2009#495",
      "type": "artigo_candidato",
      "name": "Art. 383",
      "content": "Art. 383.  O regime de drawback é considerado \r\nincentivo ŕ exportaçăo, e pode ser aplicado nas seguintes modalidades \r\n(\nDecreto-Lei nş 37, de 1966, art. 78, caput;\ne\nLei n\no\n8.402, de 1992, art. 1\no\n, inciso I)\n:",
      "attributes": {
