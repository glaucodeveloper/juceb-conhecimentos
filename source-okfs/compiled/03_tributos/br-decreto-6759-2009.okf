    {
      "id": "BR.DECRETO.6759.2009#403",
      "type": "artigo_candidato",
      "name": "Art. 305",
      "content": "Art. 305.  Săo isentos da CIDE-Combustíveis:\nI - a nafta petroquímica importada, destinada ŕ \r\nelaboraçăo, por central petroquímica, de produtos petroquímicos năo incluídos no",
