    {
      "id": "BR.DECRETO_LEI.5452.1943#167",
      "type": "artigo_candidato",
      "name": "Art. 56",
      "content": "Art. 56. O sindicato que cobrar remuneraçăo pela entrega de carteiras, facultada\r\npelo",
      "attributes": {
