        "char_start": 188047,
        "char_end": 188190
      }
    },
    {
      "id": "BR.DECRETO_LEI.5452.1943#353",
      "type": "artigo_candidato",
      "name": "Art. 449",
      "content": "art. 449.\n(Redaçăo dada pelo Decreto-lei nş 1.535, de 13.4.1977\nSECÇĂO VI\nDisposiçőes especiais\nSEÇĂO VI\nDO INÍCIO DA PRESCRIÇĂO\n(Redaçăo dada pelo\r\nDecreto-lei nş 1.535, de 13.4.1977",
      "attributes": {
