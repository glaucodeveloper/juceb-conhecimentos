    {
      "id": "BR.DECRETO_LEI.5452.1943#812",
      "type": "artigo_candidato",
      "name": "Art. 325",
      "content": "art. 325\npoderăo, por ato do\r\nDepartamento Nacional do Trabalho, sujeito ŕ aprovaçăo do Ministro, ser cassadas as\r\ngarantias asseguradas por esta Seçăo, desde que interrompam, por motivo de falta\r\nprevista no",
