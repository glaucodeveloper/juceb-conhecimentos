    {
      "id": "BR.DECRETO_LEI.5452.1943#971",
      "type": "artigo_candidato",
      "name": "Art. 424",
      "content": "Art. 424 - É dever dos responsáveis legais de menores, pais, \r\nmăes, ou tutores, afastá-los de empregos que diminuam consideravelmente o seu \r\ntempo de estudo, reduzam o tempo de repouso necessário ŕ sua saúde e \r\nconstituiçăo física, ou prejudiquem a sua educaçăo moral.",
      "attributes": {
        "automated_extraction": true,
