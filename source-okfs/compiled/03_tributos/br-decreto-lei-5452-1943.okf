    {
      "id": "BR.DECRETO_LEI.5452.1943#1052",
      "type": "artigo_candidato",
      "name": "Art. 452-H",
      "content": "Art. 452-H.  No contrato de trabalho \r\n intermitente, o empregador efetuará o recolhimento das contribuiçőes \r\n previdenciárias próprias e do empregado e o depósito do FGTS com base \r\n nos valores pagos no período mensal e fornecerá ao empregado comprovante \r\n do cumprimento dessas obrigaçőes, observado o disposto no",
      "attributes": {
        "automated_extraction": true,
        "char_start": 599011,
