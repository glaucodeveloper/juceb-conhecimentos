    {
      "id": "BR.DECRETO_LEI.5452.1943#1031",
      "type": "artigo_candidato",
      "name": "Art. 451",
      "content": "art. 451\n.\n(Redaçăo dada \r\npelo Decreto-lei nş 229, de 28.2.1967)\nParágrafo único. O contrato de experięncia năo poderá exceder de 90 (noventa) \r\ndias.\n(Incluído pelo Decreto-lei nş 229, de 28.2.1967)",
      "attributes": {
