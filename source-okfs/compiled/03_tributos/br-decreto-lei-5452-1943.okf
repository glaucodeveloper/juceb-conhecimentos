    {
      "id": "BR.DECRETO_LEI.5452.1943#399",
      "type": "artigo_candidato",
      "name": "Art. 161",
      "content": "Art.\r\n161. A iluminaçăo deverá, tanto quanto possível, vir de direçăo tal que os\r\nmovimentos realizados pelo trabalhador năo provoquem sombras sobre os locais que devam\r\nficar iluminados.",
      "attributes": {
