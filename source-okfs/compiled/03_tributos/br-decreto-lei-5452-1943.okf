    {
      "id": "BR.DECRETO_LEI.5452.1943#875",
      "type": "artigo_candidato",
      "name": "Art. 386",
      "content": "Art. 386 - Havendo trabalho aos domingos, será organizada uma escala de revezamento\r\nquinzenal, que favoreça o repouso dominical.\nSEÇĂO IV\nDOS MÉTODOS E LOCAIS DE TRABALHO",
      "attributes": {
