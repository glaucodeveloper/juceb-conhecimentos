    {
      "id": "BR.DECRETO_LEI.5452.1943#999",
      "type": "artigo_candidato",
      "name": "Art. 423",
      "content": "art. 423\no \r\nempregador ficará sujeito ŕ multa de cinquenta cruzeiros e ao pagamento de nova \r\ncarteira.",
      "attributes": {
