    {
      "id": "BR.DECRETO_LEI.5452.1943#201",
      "type": "artigo_candidato",
      "name": "Art. 68",
      "content": "Art. 68 - O trabalho em domingo, seja total ou parcial, na forma do",
      "attributes": {
