    {
      "id": "BR.DECRETO_LEI.5452.1943#1314",
      "type": "artigo_candidato",
      "name": "Art. 564",
      "content": "Art. 564 - Ŕs entidades sindicais, sendo-lhes peculiar e essencial a atribuiçăo\r\nrepresentativa e coordenadora das correspondentes categorias ou profissőes, é vedado,\r\ndireta ou indiretamente, o exercício de atividade econômica.",
      "attributes": {
