      }
    },
    {
      "id": "BR.DECRETO_LEI.5452.1943#209",
      "type": "artigo_candidato",
      "name": "Art. 70",
      "content": "Art. 70 - Salvo o\r\ndisposto nos\nartigos 68 e 69,\né vedado o trabalho em dias feriados nacionais e feriados\r\nreligiosos, nos tęrmos da legislaçăo própria.\n(Redaçăo\r\ndada pelo Decreto-lei nş 229, de 28.2.1967)",
