    {
      "id": "BR.DECRETO_LEI.5452.1943#732",
      "type": "artigo_candidato",
      "name": "Art. 7",
      "content": "art. 7ş do regulamento aprovado pelo decreto\r\nn. 3.590, de 11 de janeiro de 1939\n, substituida a carteira profissional pelo certificado\r\nde registo concedido pela repartiçăo competente.\n(Vide\r\nDecreto-Lei nş 926, de 1969)\n(Revogado pelo Decreto-Lei nş 972, de 17.10.1969)",
      "attributes": {
