    {
      "id": "BR.DECRETO_LEI.5452.1943#137",
      "type": "artigo_candidato",
      "name": "Art. 48",
      "content": "Art. 48 - As multas previstas nesta Seçăo serăo aplicadas pela autoridade de primeira\r\ninstância no Distrito Federal, e pelas autoridades regionais do Ministério do Trabalho,\r\nIndustria e Comercio, nos Estados e no Território do Acre.\nSEÇĂO VIII\nDAS PENALIDADES",
      "attributes": {
