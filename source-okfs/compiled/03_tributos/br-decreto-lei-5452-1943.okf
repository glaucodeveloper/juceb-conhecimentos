    {
      "id": "BR.DECRETO_LEI.5452.1943#793",
      "type": "artigo_candidato",
      "name": "Art. 343",
      "content": "Art. 343 - Săo atribuiçőes dos órgăos de fiscalizaçăo:\na) examinar os documentos exigidos para o registro \r\nprofissional de que trata o",
      "attributes": {
        "automated_extraction": true,
        "char_start": 455375,
