    {
      "id": "BR.DECRETO_LEI.5452.1943#974",
      "type": "artigo_candidato",
      "name": "Art. 407",
      "content": "art. 407\n, \r\nproporcionar ao menor todas as facilidades para mudar de serviço.",
      "attributes": {
