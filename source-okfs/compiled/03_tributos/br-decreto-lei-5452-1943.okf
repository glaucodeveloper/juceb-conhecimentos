    {
      "id": "BR.DECRETO_LEI.5452.1943#119",
      "type": "artigo_candidato",
      "name": "Art. 41",
      "content": "art. 41\ne seu parágrafo\r\núnico, incorrerá na multa de valor igual a 1 (um) salário-mínimo regional, por\r\nempregado năo registrado, acrescido de igual valor em cada reincidęncia.\n(Redaçăo dada pelo Decreto-lei nş 229, de 28.2.1967)\nParágrafo único. As demais infraçőes referentes ao registro de empregados sujeitarăo\r\na empręsa ŕ multa de valor igual ŕ metade do salário-mínimo regional, dobrada na\r\nreincidęncia.\n(Parágrafo incluído pelo Decreto-lei nş 229,\r\nde 28.2.1967)",
      "attributes": {
        "automated_extraction": true,
        "char_start": 74091,
        "char_end": 74564
      }
    },
