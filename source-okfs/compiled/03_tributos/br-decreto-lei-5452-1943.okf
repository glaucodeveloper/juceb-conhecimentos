    {
      "id": "BR.DECRETO_LEI.5452.1943#92",
      "type": "artigo_candidato",
      "name": "Art. 29",
      "content": "art. 29\nou a devolver a\r\nCarteira de Trabalho e Previdęncia Social recebida, poderá o empregado comparecer,\r\npessoalmente ou intermédio de seu sindicato perante a Delegacia Regional ou órgăo\r\nautorizado, para apresentar reclamaçăo.\n(Redaçăo dada pelo\r\nDecreto-lei nş 229, de 28.2.1967\n)",
      "attributes": {
