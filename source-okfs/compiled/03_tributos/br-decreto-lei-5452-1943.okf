    },
    {
      "id": "BR.DECRETO_LEI.5452.1943#1100",
      "type": "artigo_candidato",
      "name": "Art. 476",
      "content": "Art. 476 - Em caso de seguro-doença ou auxílio-enfermidade, o empregado é considerado\r\nem licença năo remunerada, durante o prazo desse benefício.",
