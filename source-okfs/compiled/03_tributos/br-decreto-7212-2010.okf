    {
      "id": "BR.DECRETO.7212.2010#593",
      "type": "artigo_candidato",
      "name": "Art. 338",
      "content": "Art. 338.  As disposições relativas ao cancelamento de que trata o",
      "attributes": {
        "automated_extraction": true,
