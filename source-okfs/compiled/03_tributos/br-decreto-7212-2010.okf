      }
    },
    {
      "id": "BR.DECRETO.7212.2010#997",
      "type": "artigo_candidato",
      "name": "Art. 616",
      "content": "Art. 616.  Este Decreto entra em vigor na data de sua \r\n publicação.",
      "attributes": {
