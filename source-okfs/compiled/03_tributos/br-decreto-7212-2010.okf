      "type": "artigo_candidato",
      "name": "Art. 212-A",
      "content": "art. 212-A (\nLei nº 12.546, de 2011, art. 17, § 3º\n, e\nLei nº 12.402, de 2011,",
      "attributes": {
        "automated_extraction": true,
        "char_start": 327759,
        "char_end": 327841
