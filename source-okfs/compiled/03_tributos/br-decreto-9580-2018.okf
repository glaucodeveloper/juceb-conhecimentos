    {
      "id": "BR.DECRETO.9580.2018#1221",
      "type": "artigo_candidato",
      "name": "Art. 685",
      "content": "Art. 685. Ficam sujeitos ŕ incidęncia do imposto sobre a renda na fonte, calculado de acordo com as tabelas progressivas constantes do",
