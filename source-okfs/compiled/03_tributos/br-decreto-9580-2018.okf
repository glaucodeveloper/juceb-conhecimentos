    {
      "id": "BR.DECRETO.9580.2018#1167",
      "type": "artigo_candidato",
      "name": "Art. 659",
      "content": "Art. 659. O direito ŕ aplicaçăo em incentivos fiscais previstos neste Regulamento será sempre assegurado ŕs pessoas jurídicas de que trata o",
      "attributes": {
        "automated_extraction": true,
