      }
    },
    {
      "id": "BR.DECRETO.9580.2018#157",
      "type": "artigo_candidato",
      "name": "Art. 104",
      "content": "art. 104 ao art. 110\n;\nVI - a contribuiçăo patronal paga ŕ previdęncia social pelo empregador doméstico incidente sobre o valor da remuneraçăo do empregado, de que tratam o",
      "attributes": {
