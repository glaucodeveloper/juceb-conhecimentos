    {
      "id": "BR.DECRETO.9580.2018#4",
      "type": "artigo_candidato",
      "name": "Art. 4",
      "content": "Art. 4ş Fica revogado o\nDecreto nş 3.000, de 26 de março de 1999\n.",
      "attributes": {
