    {
      "id": "BR.LC.87.1996#41",
      "type": "artigo_candidato",
      "name": "Art. 35",
      "content": "Art. 35. As referęncias feitas aos Estados nesta Lei Complementar entendem-se feitas\r\ntambém ao Distrito Federal.",
