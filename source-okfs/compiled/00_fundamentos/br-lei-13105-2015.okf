    {
      "id": "BR.LEI.13105.2015#1238",
      "type": "artigo_candidato",
      "name": "Art. 1",
      "content": "Art. 1.067. O art. 275 da\nLei nş 4.737, de 15 de julho de 1965 (Código Eleitoral)\n, passa a vigorar com a seguinte redaçăo:\n(Vigęncia)\n“",
      "attributes": {
