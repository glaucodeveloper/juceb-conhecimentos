    {
      "id": "BR.LC.227.2026#256",
      "type": "artigo_candidato",
      "name": "Art. 98-A",
      "content": "Art. \r\n 98-A\n.\nO regulamento poderá prever hipóteses em que os regimes aduaneiros \r\n especiais de que tratam os arts. 84, 85, 88 e 90 desta Lei \r\n Complementar serăo aplicados a bens materiais com destino ao \r\n exterior, inclusive em caso de saída temporária do País.",
      "attributes": {
