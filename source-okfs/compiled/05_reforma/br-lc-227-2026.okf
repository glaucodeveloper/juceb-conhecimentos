    {
      "id": "BR.LC.227.2026#185",
      "type": "artigo_candidato",
      "name": "Art. 82",
      "content": "art. 82 do ADCT\n, será apurada:\nI - para cada \r\n Estado, a relaçăo percentual entre a receita média auferida com o adicional \r\n de alíquotas previsto no\n§ 1ş do art. 82 do ADCT\ne a receita bruta média do \r\n ICMS, considerando para ambas o período de 2019 a 2026;\nII - para o \r\n Distrito Federal, a relaçăo percentual entre a receita média auferida com os \r\n adicionais de alíquotas previstos nos\n§§ 1ş\ne\n2ş do art. 82 do ADCT\ne a \r\n receita bruta média dos impostos previstos no\ninciso II do caput do",
      "attributes": {
        "automated_extraction": true,
        "char_start": 188712,
        "char_end": 189215
      }
