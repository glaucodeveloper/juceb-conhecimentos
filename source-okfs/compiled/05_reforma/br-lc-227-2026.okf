    {
      "id": "BR.LC.227.2026#327",
      "type": "artigo_candidato",
      "name": "Art. 180",
      "content": "Art. 180.\nO prazo de que trata o\n§ 5ş-A do art. 481 da Lei \r\n Complementar nş 214, de 16 de janeiro de 2025\n, năo se considera findo antes \r\n do transcurso de 15 (quinze) dias, contados da publicaçăo desta Lei \r\n Complementar.",
      "attributes": {
