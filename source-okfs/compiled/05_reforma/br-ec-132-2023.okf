    {
      "id": "BR.EC.132.2023#34",
      "type": "artigo_candidato",
      "name": "Art. 8",
      "content": "Art. 8º Fica criada a Cesta Básica Nacional de \r\nAlimentos, que considerará a diversidade regional e cultural da alimentação do \r\nPaís e garantirá a alimentação saudável e nutricionalmente adequada, em \r\nobservância ao direito social à alimentação previsto no",
      "attributes": {
        "automated_extraction": true,
        "char_start": 82786,
