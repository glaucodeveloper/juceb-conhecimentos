      "id": "BR.DECRETO.12955.2026#710",
      "type": "artigo_candidato",
      "name": "Art. 533",
      "content": "Art. 533.  O crédito presumido de CBS de que trata o",
      "attributes": {
        "automated_extraction": true,
        "char_start": 646595,
        "char_end": 646650
