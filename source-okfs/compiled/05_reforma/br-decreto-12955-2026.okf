    {
      "id": "BR.DECRETO.12955.2026#833",
      "type": "artigo_candidato",
      "name": "Art. 15",
      "content": "art. 15, § 4ş\ne\n§ 7ş, da Lei nş 10.865, de 30 de abril de 2004\n; e\nIV - no",
      "attributes": {
