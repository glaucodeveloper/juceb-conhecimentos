      "type": "artigo_candidato",
      "name": "Art. 5",
      "content": "art. \r\n 5ş, parágrafo único, da Lei nş 13.464, de 10 de julho de 2017\n;",
      "attributes": {
        "automated_extraction": true,
        "char_start": 662705,
        "char_end": 662777
      }
    },
    {
      "id": "BR.DECRETO.12955.2026#740",
      "type": "artigo_candidato",
      "name": "Art. 6",
      "content": "art. 6ş, \r\n inciso I, da Lei nş 10.593, de 6 de dezembro de 2002)",
