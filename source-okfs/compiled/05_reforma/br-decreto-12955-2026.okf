    {
      "id": "BR.DECRETO.12955.2026#111",
      "type": "artigo_candidato",
      "name": "Art. 155",
      "content": "art. 155, caput, inciso II, da Constituiçăo\n; \r\n e\nIII - o Imposto sobre Serviços de Qualquer Natureza – ISS, previsto no",
      "attributes": {
