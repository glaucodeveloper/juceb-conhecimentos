      }
    },
    {
      "id": "BR.DECRETO.12955.2026#400",
      "type": "artigo_candidato",
      "name": "Art. 303",
      "content": "Art. 303.  A base de cálculo da CBS no regime \r\n específico desta Seçăo é composta pela totalidade das receitas advindas das \r\n operaçőes de gestăo e administraçăo de recursos, inclusive de fundos de \r\n investimento.\n(Art. 185 da Lei \r\n Complementar nş 214, de 16 de janeiro de 2025)",
      "attributes": {
