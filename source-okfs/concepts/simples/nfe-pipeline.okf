{
  "schema": "okfforge.juceb.research_map.v1",
  "id": "BR.KNOWLEDGE.NFE_SIMPLES_PIPELINE",
  "title": "Pipeline NF-e e estimativa do Simples Nacional",
  "summary": "Processa NF-e de mercadorias, associa a parte do cliente, registra propriedades e só calcula estimativa documental quando a receita, o período, o perfil e a segregação legal estão suportados.",
  "elements": [
    { "id": "nfe-simples.1", "type": "fator_de_decisao", "name": "competencia e data de vigencia da regra" },
    { "id": "nfe-simples.2", "type": "fator_de_decisao", "name": "modelo, finalidade, tpNF e autorizacao do documento" },
    { "id": "nfe-simples.3", "type": "fator_de_decisao", "name": "emitente, destinatario e CNPJ associado ao cliente" },
    { "id": "nfe-simples.4", "type": "fator_de_decisao", "name": "atividade efetiva e natureza da receita" },
    { "id": "nfe-simples.5", "type": "fator_de_decisao", "name": "RBT12, faixa, anexo e alíquota efetiva" },
    { "id": "nfe-simples.6", "type": "fator_de_decisao", "name": "receita bruta do periodo e base documental reconciliada" },
    { "id": "nfe-simples.7", "type": "fator_de_decisao", "name": "segregacao por atividade, estabelecimento e tratamento tributario" },
    { "id": "nfe-simples.8", "type": "fator_de_decisao", "name": "CSOSN/CST, CFOP, NCM, CEST, ST, monofasico, exportacao e devolucao" },
    { "id": "nfe-simples.9", "type": "fator_de_decisao", "name": "regime de competencia ou caixa e recebimentos efetivos" },
    { "id": "nfe-simples.10", "type": "fator_de_decisao", "name": "ISSQN, municipio, retencoes, fator R e documento NFS-e" }
  ],
  "properties": [
    { "name": "jurisdicao", "value": "Brasil; UF e municipio da operacao devem ser identificados" },
    { "name": "escopo_automatico", "value": "NF-e modelo 55 de mercadorias; estimativa documental por nota com regras versionadas ate 2026-12" },
    { "name": "entrada_nao_e_receita", "value": true },
    { "name": "cfop_ncm_nao_definem_atividade_sozinhos", "value": true },
    { "name": "receita_de_servico_exige_fluxo_nfs_e", "value": true },
    { "name": "nao_calcular_sem_segregacao_especial", "value": true },
    { "name": "estimativa_por_documento_nao_e_das_mensal", "value": true },
    { "name": "declaracao_oficial", "value": "PGDAS-D; totalidade das receitas auferidas/recebidas, segregadas no periodo" },
    { "name": "certificado_e_autorizacao_sefaz_nao_inferidos_do_xml", "value": true },
    { "name": "efeitos_2027", "value": "Revalidar atos CGSN e transicao CBS/IBS antes de processar competencia 2027 ou posterior." }
  ],
  "relations": [
    { "type": "fundamentado_em", "target": "BR.LC.123.2006" },
    { "type": "fundamentado_em", "target": "BR.LC.155.2016" },
    { "type": "fundamentado_em", "target": "BR.RESOLUÇÃO_CGSN.140.2018" },
    { "type": "fundamentado_em", "target": "BR.RESOLUÇÃO_CGSN.190.2026" },
    { "type": "fundamentado_em", "target": "BR.RESOLUÇÃO_CGSN.191.2026" },
    { "type": "formato_e_validacao", "target": "BR.PORTAL_ENCAT.nfe.2026" },
    { "type": "procedimento_declaratorio", "target": "BR.RFB.PGDAS-D.MANUAL.2025" }
  ],
  "functions": [
    {
      "name": "processar_nfe_e_estimar_simples",
      "type": "deterministic_pipeline",
      "inputs": ["XML NF-e", "CNPJ e regime do cliente", "atividade e anexo validados", "RBT12", "regime de apuracao", "receitas segregadas", "competencia"],
      "steps": [
        "Parsear namespace, chave, partes, data, natureza, itens, totais e grupos tributarios do XML.",
        "Validar o arquivo contra a versao de XSD correspondente a competencia e manter separadas validade estrutural, assinatura, autorizacao e eventos fiscais.",
        "Associar pela parte contribuinte: emitente na saida e destinatario na entrada; manter entradas fora da base de receita de saida.",
        "Classificar atividade/receita por cadastro fiscal e evidencias; nao deduzir o anexo apenas do nome, CFOP, NCM ou CSOSN.",
        "Reconciliar itens, totais e base documental; registrar campos dinamicos, fonte, versao normativa e trilha do processamento.",
        "Segregar receitas e encaminhar ST/antecipacao, monofasico, exportacao, devolucao/cancelamento, isencao, suspensao, ISSQN e retencoes para regra especifica.",
        "Quando todos os parametros legais da categoria estiverem configurados, aplicar a tabela do anexo e registrar formula, faixa, aliquota nominal, parcela a deduzir e aliquota efetiva.",
        "Agregar e reconciliar a totalidade da receita da empresa por estabelecimento, atividade e PA antes de qualquer simulacao mensal; direcionar a declaracao ao PGDAS-D."
      ],
      "outputs": ["propriedades extraidas", "vinculo de cliente", "receita/segregacao", "estimativa ou pendencia tipificada", "versao legal", "trilha auditavel"],
      "stop_conditions": ["competencia fora da vigencia do ruleset", "RBT12 ausente ou regra de inicio de atividade", "atividade/anexo incerto", "receita em regime de caixa sem recebimentos", "documento de entrada", "tratamento especial sem regra", "base documental nao reconciliada"],
      "requires_live_source_validation": true
    }
  ],
  "sources": [
