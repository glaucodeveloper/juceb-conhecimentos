    {
      "id": "BR.LC.214.2025#634",
      "type": "artigo_candidato",
      "name": "Art. 476",
      "content": "Art. 476\n.\nO Poder Executivo da Uniăo realizará avaliaçăo quinquenal da \r\n eficięncia, eficácia e efetividade, enquanto política social, ambiental \r\n e sanitária, da incidęncia do Imposto Seletivo de que trata o Livro II.\n§ 1ş A \r\n avaliaçăo de que trata este artigo será realizada simultaneamente ŕ \r\n avaliaçăo de que trata o art. 475 desta Lei Complementar.\n§ 2ş \r\n Aplica-se ŕ avaliaçăo de que trata este artigo, no que couber, o \r\n disposto no art. 475 desta Lei Complementar.\nCAPÍTULO II\nDA COMPENSAÇĂO DE EVENTUAL REDUÇĂO DO MONTANTE ENTREGUE NOS TERMOS DO",
      "attributes": {
        "automated_extraction": true,
