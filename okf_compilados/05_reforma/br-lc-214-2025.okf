    {
      "id": "BR.LC.214.2025#424",
      "type": "artigo_candidato",
      "name": "Art. 156",
      "content": "art. 156, III, da Constituiçăo Federal\n, e ŕ reduçăo \r\n dos benefícios fiscais relacionados a este imposto entre 2029 e 2032;\nIII - arts. \r\n 361 a 365 desta Lei Complementar, no que diz respeito ŕ fixaçăo das \r\n alíquotas de referęncia do IBS de 2029 a 2033; e\nIV - arts. \r\n 366 e 369 desta Lei Complementar, no que diz respeito ŕ fixaçăo das \r\n alíquotas de referęncia do IBS em 2034 e 2035.",
      "attributes": {
