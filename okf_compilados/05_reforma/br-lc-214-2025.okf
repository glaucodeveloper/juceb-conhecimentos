    {
      "id": "BR.LC.214.2025#636",
      "type": "artigo_candidato",
      "name": "Art. 477",
      "content": "Art. 477.\nA partir de 2027, a Uniăo compensará, na forma deste Título, \r\n eventual reduçăo no montante dos valores entregues nos termos do",
      "attributes": {
        "automated_extraction": true,
        "char_start": 674293,
