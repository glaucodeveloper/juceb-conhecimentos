    },
    {
      "id": "BR.LC.214.2025#593",
      "type": "artigo_candidato",
      "name": "Art. 453",
      "content": "Art. 453.\nAs operaçőes com bens e serviços ocorridas dentro da Zona Franca de \r\n Manaus ou destinadas ŕ referida área, inclusive importaçőes, que năo \r\n estejam contempladas pelo disposto nos arts. 443, 445, 446 e 448 desta \r\n Lei Complementar sujeitam-se ŕ incidęncia do IBS e da CBS com base nas \r\n demais regras previstas nesta Lei Complementar.",
      "attributes": {
        "automated_extraction": true,
