    {
      "id": "BR.LEI.14133.2021#123",
      "type": "artigo_candidato",
      "name": "Art. 100",
      "content": "Art. \r\n 100. A garantia prestada pelo contratado será liberada ou restituída após a \r\n fiel execuçăo do contrato ou após a sua extinçăo por culpa exclusiva da \r\n Administraçăo e, quando em dinheiro, atualizada monetariamente.",
      "attributes": {
