        "char_end": 48205
      }
    },
    {
      "id": "BR.LEI.10741.2003#90",
      "type": "artigo_candidato",
      "name": "Art. 52",
      "content": "Art. 52.\nAs entidades governamentais e năo-governamentais de atendimento ao idoso\r\nserăo fiscalizadas pelos Conselhos do Idoso, Ministério Público, Vigilância Sanitária\r\ne outros previstos em lei.",
      "attributes": {
