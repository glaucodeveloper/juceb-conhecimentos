    {
      "id": "BR.LEI.9605.1998#89",
      "type": "artigo_candidato",
      "name": "Art. 80",
      "content": "Art. 80. O Poder Executivo regulamentará esta Lei no prazo de noventa dias a contar de\r\n sua publicaçăo.",
