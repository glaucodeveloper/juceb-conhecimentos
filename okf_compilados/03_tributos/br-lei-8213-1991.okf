    {
      "id": "BR.LEI.8213.1991#215",
      "type": "artigo_candidato",
      "name": "Art. 106",
      "content": "Art. \r\n 106. A comprovaçăo do exercício de atividade rural será feita, \r\n complementarmente ŕ declaraçăo de que trata o art. 38-B, por meio de:\n(Redaçăo dada pela Medida \r\nProvisória nş 871, de 2019)",
      "attributes": {
