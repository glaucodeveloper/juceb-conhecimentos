    {
      "id": "BR.LEI.8213.1991#256",
      "type": "artigo_candidato",
      "name": "Art. 124-G",
      "content": "Art. 124-G. O tratamento de dados pessoais pelo INSS \r\ndeverá observar as disposiçőes da\nLei nş 13.709, de 14 de agosto de 2018\n(Lei Geral de Proteçăo de Dados \r\nPessoais), inclusive quanto ŕs sançőes administrativas, ŕ segurança e ŕ vedaçăo \r\nde compartilhamento năo autorizado de dados dos beneficiários, sem prejuízo das \r\nresponsabilidades penal e civil.\n(Incluído pela Lei nş \r\n15.327, de 2026)\nTÍTULO IV\nDAS DISPOSIÇŐES FINAIS E TRANSITÓRIAS",
      "attributes": {
        "automated_extraction": true,
        "char_start": 283076,
        "char_end": 283524
      }
    },
    {
      "id": "BR.LEI.8213.1991#257",
      "type": "artigo_candidato",
      "name": "Art. 125",
      "content": "Art. 125 .Nenhum benefício ou serviço da Previdęncia Social poderá ser\r\ncriado, majorado ou estendido, sem a correspondente fonte de custeio total.",
      "attributes": {
