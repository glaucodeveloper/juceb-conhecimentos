    {
      "id": "BR.LEI.8981.1995#125",
      "type": "artigo_candidato",
      "name": "Art. 161",
      "content": "art. 161, §\r\n1ş , da Lei nş 5.172, de 25 de outubro de 1966.",
      "attributes": {
