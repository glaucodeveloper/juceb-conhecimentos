    {
      "id": "BR.LEI.8981.1995#96",
      "type": "artigo_candidato",
      "name": "Art. 71",
      "content": "Art. 71. Fica dispensada a retençăo\r\n do Imposto de Renda na fonte sobre rendimentos de aplicaçőes financeiras de renda fixa\r\n ou de renda variável quando o beneficiário do rendimento declarar ŕ fonte pagadora, por\r\n escrito, sua condiçăo de entidade imune.\n(Redaçăo dada \r\npela Medida Provisória nş 998, de 1995)",
      "attributes": {
        "automated_extraction": true,
        "char_start": 85618,
        "char_end": 85932
      }
