  "elements": [
    {
      "id": "BR.DECRETO.11158.2022#1",
      "type": "artigo_candidato",
      "name": "Art. 1",
      "content": "Art. \r\n 1ş  Fica aprovada a Tabela de Incidęncia do Imposto sobre Produtos \r\n Industrializados - TIPI, anexa a este Decreto.",
      "attributes": {
        "automated_extraction": true,
