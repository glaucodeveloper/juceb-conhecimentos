        "char_end": 138837
      }
    },
    {
      "id": "BR.LEI.10833.2003#148",
      "type": "artigo_candidato",
      "name": "Art. 4",
      "content": "art. 4\no\ndo\r\nDecreto-Lei n\no\n2.472, de 1988\n;\nII - o",
      "attributes": {
