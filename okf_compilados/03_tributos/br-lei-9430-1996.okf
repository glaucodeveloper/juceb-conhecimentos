    {
      "id": "BR.LEI.9430.1996#151",
      "type": "artigo_candidato",
      "name": "Art. 81",
      "content": "art. 81 da Lei nş 8.981, de 20 de\r\njaneiro de 1995\n, a pessoa jurídica que efetuar o pagamento dos rendimentos.\n(Vide Medida \r\n Provisória nş 1.303, de 2025)\nProduçăo de efeitos\nVigęncia encerrada\nSeçăo VI\nCasos Especiais de Tributaçăo\nMultas por Rescisăo de Contrato",
      "attributes": {
        "automated_extraction": true,
        "char_start": 163890,
