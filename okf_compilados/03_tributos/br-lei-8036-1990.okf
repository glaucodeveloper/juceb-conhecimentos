    {
      "id": "BR.LEI.8036.1990#50",
      "type": "artigo_candidato",
      "name": "Art. 17",
      "content": "Art. 17. Os empregadores se obrigam a comunicar mensalmente aos trabalhadores os valores\r\nrecolhidos ao FGTS e repassar-lhes todas as informaçőes sobre suas contas vinculadas\r\nrecebidas da Caixa Econômica Federal ou dos bancos depositários.",
