    {
      "id": "BR.CONSTITUIÇÃO.1988.1988#434",
      "type": "artigo_candidato",
      "name": "Art. 113",
      "content": "Art. \r\n 113. A proposiçăo legislativa que crie ou altere despesa obrigatória ou \r\n renúncia de receita deverá ser acompanhada da estimativa do seu impacto \r\n orçamentário e financeiro.\n(Incluído pela Emenda Constitucional nş \r\n95, de 2016)",
      "attributes": {
