    {
      "id": "BR.CONSTITUIÇÃO.1988.1988#176",
      "type": "artigo_candidato",
      "name": "Art. 157",
      "content": "Art. 157. Pertencem aos Estados e ao Distrito Federal:\nI - o produto da arrecadaçăo do imposto da Uniăo sobre renda e proventos de qualquer\r\nnatureza, incidente na fonte, sobre rendimentos pagos, a qualquer título, por eles, suas\r\nautarquias e pelas fundaçőes que instituírem e mantiverem;\nII - vinte por cento do produto da arrecadaçăo do imposto que a Uniăo instituir no\r\nexercício da competęncia que lhe é atribuída pelo art. 154, I.",
      "attributes": {
        "automated_extraction": true,
        "char_start": 326424,
        "char_end": 326861
      }
