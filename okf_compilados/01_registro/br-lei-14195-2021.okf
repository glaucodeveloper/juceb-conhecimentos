    {
      "id": "BR.LEI.14195.2021#107",
      "type": "artigo_candidato",
      "name": "Art. 37",
      "content": "art. 37\n;\nXXXII \r\n - os\nincisos I\n,\nII,\nIII\n,\nIV\ne\nV do caput do art. 246 da Lei nş \r\n 13.105, de 16 de março de 2015 (Código de Processo Civil).",
      "attributes": {
